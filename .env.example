# ================================
# SMARTSTORE - SaaS ECommerce Platform
# Environment Configuration
# ================================

# =========================================
# FRONTEND ENVIRONMENT VARIABLES
# =========================================

# API Base URL (Development)
VITE_API_URL=http://localhost:5000/api

# Socket URL (Development)
VITE_SOCKET_URL=http://localhost:5000

# API Base URL (Production will be set by Vercel/deployment)
# VITE_API_URL=https://your-api-url.com/api

# =========================================
# BACKEND ENVIRONMENT VARIABLES
# =========================================

# Port
PORT=5000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/smartstore?schema=public"

# JWT Authentication
# GENERATE A RANDOM SECRET FOR PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cookie Secret
COOKIE_SECRET=your-cookie-secret-here

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_RATE_LIMIT_MAX_REQUESTS=1000

# Storage
STORAGE_TYPE=local
# S3 or filesystem storage config
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Email (for notifications - abstracted layer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@smartstore.com

# =========================================
# PROVIDERS (Abstracted for future use)
# =========================================

# WhatsApp API (for OTP notifications)
# DEVELOPMENT MODE - DO NOT USE REAL API KEYS
WHATSAPP_API_KEY=
# WhatsApp phone number
WHATSAPP_PHONE=

# Payment Provider
# Options: cash, upi, card, manual
DEFAULT_PAYMENT_METHOD=cash
# Payment provider config (if using external)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# =========================================
# FEATURES FLAGS
# =========================================

# Enable email notifications
ENABLE_EMAIL=true

# Enable WhatsApp notifications
ENABLE_WHATSAPP=false

# Enable demo mode
DEMO_MODE=false

# Enable admin features
ENABLE_PLATFORM_ADMIN=true

# =========================================
# DEBUG
# =========================================

NODE_ENV=development
DEBUG=*