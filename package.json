{
  "name": "smartstore",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade multi-tenant SaaS e-commerce platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces && npm run install:backend",
    "install:frontend": "cd client && npm install",
    "install:backend": "cd server && npm install",
    "dev": "npm run dev:backend",
    "dev:backend": "cd server && npm run dev",
    "dev:frontend": "cd client && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd server && npm run build",
    "build:frontend": "cd client && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd server && npm run start",
    "start:frontend": "cd client && npm run preview",
    "prisma:validate": "cd server && npm run prisma:validate",
    "prisma:generate": "cd server && npm run prisma:generate",
    "test:smoke": "cd server && npm run test:smoke",
    "test:commerce": "cd server && npm run test:commerce",
    "vercel": "vercel",
    "vercel:prod": "vercel --prod"
  },
  "keywords": [
    "ecommerce",
    "saas",
    "multi-tenant",
    "headless",
    "white-label"
  ],
