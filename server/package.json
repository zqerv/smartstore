{
  "name": "smartstore-server",
  "version": "1.0.0",
  "private": true,
  "description": "SmartStore API server",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build:shared && npm run prisma:generate && tsc -p tsconfig.json",
    "build:shared": "cd ../shared && npm run build",
    "start": "node dist/server.js",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "test:smoke": "node test-backend.js",
    "test:commerce": "node test-commerce.js",
    "test:security": "node test-security.js",
    "test:realtime": "node test-realtime.js",
    "test:features": "node test-features.js",
    "test:cors": "node --import tsx --test tests/cors.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@smartstore/shared": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
